# Copie para .env na raiz. Variáveis do ambiente têm prioridade sobre o arquivo.
APP_ENV=production
PUBLIC_ORIGIN=https://loja.example.com
# 64 hexadecimal characters. Used both for SQLCipher and AES-256-GCM envelope encryption (crypto_vault.py).
DATABASE_KEY=

# Supabase PostgreSQL (server-side only; NEVER expose in frontend)
SUPABASE_URL=
SUPABASE_DB_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mistic Pay: create access keys with TRANSACTION_CREATE and TRANSACTION_READ.
MISTIC_CLIENT_ID=
MISTIC_CLIENT_SECRET=
# Must be a text-channel webhook. Full URL, stored only on the server.
DISCORD_WEBHOOK_URL=

# SMTP configuration for one-time password (OTP) email verification.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=1
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@loja.example.com

# OAuth 2.0 (Google & Discord)
# Redirect URI Google:  http://localhost:8000/api/auth/oauth/google/callback
# Redirect URI Discord: http://localhost:8000/api/auth/oauth/discord/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# UTMify server API token; configure in both web and commerce worker environments.
UTMIFY_API_TOKEN=

# Base local MaxMind City opcional para o mapa de visitas
GEOIP_DATABASE_PATH=
# CIDRs de proxies controlados que sobrescrevem X-Real-IP; vazio não confia em cabeçalhos
GEOIP_TRUSTED_PROXIES=

# Provedor de novos pagamentos: pantera ou mistic.
PAYMENT_PROVIDER=pantera
PANTERA_API_KEY=
